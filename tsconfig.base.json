{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["bun"],
    "paths": {
      "@asenajs/adapter-conformance": ["./packages/conformance/src/index.ts"],
      "@asenajs/adapter-conformance/helpers": ["./packages/conformance/src/helpers/index.ts"]
    }
  }
}
