{
  "name": "asena-test-suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "ecosystem"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "test:p1": "bun --cwd=packages/conformance test ./test/",
    "test:p2": "bun ecosystem/run.ts",
    "test:helpers": "bun test tools/helpers-test",
    "validate": "bun tools/validate/index.ts",
    "pack:local": "bun tools/pack-local.ts",
    "build": "bun --cwd=packages/conformance run build"
  },
  "devDependencies": {
    "@asenajs/asena": "^0.12.1",
    "@asenajs/ergenecore": "^5.0.2",
    "@asenajs/hono-adapter": "^5.0.3",
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "hono": ">=4.12.9",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@asenajs/asena": "^0.12.1"
  }
}
